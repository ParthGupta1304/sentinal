# Sentinel — environment template
#
# Copy to .env.local and fill in real values. .env.local is gitignored and must
# never be committed (PRD §9.4). Before recording the demo, confirm no key is
# visible in any terminal pane, browser devtools, or config file on screen.
#
#   cp .env.example .env.local


# --- Models -----------------------------------------------------------------

# Orchestrator and judge. The judge MUST be a different family from the subject
# model below: a model grading its own output measures self-consistency, not
# quality (§6.3). ORCHESTRA runs on OpenAI, so the judge runs on Anthropic.
# Get one at https://console.anthropic.com — needs credit on the account.
# A Claude Code subscription is not an API key.
ANTHROPIC_API_KEY=

# Subject under test. ORCHESTRA's judge agents call gpt-4o-mini at temperature
# 0.2, and the eval suite must hit the same model the real prompt uses.
# Same value as OPENAI_API_KEY in ORCHESTRA/backend/.env.
OPENAI_API_KEY=


# --- GitHub -----------------------------------------------------------------

# Personal access token (classic) with `repo` scope. Passed to the TrueForge
# `github` MCP server, which is remote and authenticates via a bearer header:
#   Authorization: Bearer <token>
# Create at https://github.com/settings/tokens
GITHUB_PAT=

# Repository Sentinel watches, as owner/name.
SENTINEL_REPO=ParthGupta1304/ORCHESTRA

# Directory within that repo holding the prompts under test (§3: one repo, one
# prompt directory).
SENTINEL_PROMPT_DIR=backend/prompts


# --- TrueForge --------------------------------------------------------------

# Local harness, started with `npx @truefoundry/trueforge`. Standalone mode runs
# without auth, so no token is needed for the local API.
TRUEFORGE_URL=http://localhost:8790


# --- Eval suite -------------------------------------------------------------

# Repeats per case per version (§6.5). N=3 is the working default and what the
# noise floor is calibrated against. Use N=1 while developing to save spend;
# N=3 for the demo run.
SENTINEL_RUNS_PER_CASE=3

# Where run records live. SQLite, no ORM, no migrations framework (§7).
SENTINEL_DB_PATH=./sentinel.db
